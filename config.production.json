{
  "parallel": true,
  "timeout": 300,
  "fail_fast": false,
  "cache_dir": "cache",
  "log_dir": "logs",
  "researcher": {
    "cache_size": 2000,
    "max_workers": 5,
    "search_engines": ["metaso", "duckduckgo", "bing", "baidu", "sogou", "360"],
    "min_score": 0.3,
    "max_results": 20
  },
  "fetcher": {
    "max_downloads": 15,
    "temp_dir": "tmp_fetcher",
    "download_workers": 5
  },
  "writer": {
    "template_dir": "templates",
    "similarity_threshold": 0.8,
    "polish_cache_ttl": 3600
  },
  "quality_gate": {
    "quality_profile": "technical-doc",
    "threshold": 70,
    "max_regenerations": 3
  },
  "safe_writer": {
    "backup_dir": "backups",
    "backup_ttl_days": 7,
    "max_backups": 20
  },
  "layout": {
    "dry_run": false
  },
  "admin_api": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 8910
  }
}
