# 密钥与本地配置（绝不可打进镜像）
.env
*.env
*.secret
config/secrets.yaml
config/secrets.yml
credentials.json

# 构建/运行时产物
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytest_tmp/
.test_checkpoints/
.test_outputs/
output/
logs/
dist/
build/

# 运行时数据目录（由 Dockerfile 显式创建并挂卷，不打包宿主机数据）
checkpoints/
versions/
backups/
cache/
bus_data/

# 会话/工具目录
.zcode/
.workbuddy/

# 非运行时内容（镜像瘦身：tests 18K 行/docs/基准脚本/审计产物不进镜像）
tests/
docs/
deliverables/
.github/
benchmark.py
benchmark_results.json
.coverage
htmlcov/
.dockerignore

# 版本控制与编辑器
.git/
.gitignore
.idea/
.vscode/

# 依赖（用 requirements 重新安装，不要拷宿主机的）
venv/
.venv/
