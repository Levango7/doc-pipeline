# doc-pipeline 环境变量模板
# 复制为 .env 并填入真实 API Key
# .env 已在 .gitignore 中，不会提交

# ── LLM 配置 ──────────────────────────────
# 主力：Cloudflare Workers AI
LLM_API_KEY=your_cloudflare_api_key
LLM_API_URL=https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/run
LLM_MODEL=@cf/moonshotai/kimi-k2.6

# 注：llm_router 仅支持 OpenAI 兼容接口；Claude 原生接口非此格式，故未预置，可经第三方兼容网关接入。
# ── DeepSeek（推荐，性价比高）──
# 取消注释即激活
# DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=sk-your_deepseek_key

# ── Moonshot Kimi ──
# MOONSHOT_API_URL=https://api.moonshot.cn/v1/chat/completions
# MOONSHOT_MODEL=moonshot-v1-32k
# MOONSHOT_API_KEY=your_moonshot_key

# ── 通义千问 Qwen（DashScope OpenAI 兼容模式）──
# QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# QWEN_MODEL=qwen-plus
# QWEN_API_KEY=your_dashscope_key

# ── OpenAI ──
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-your_openai_key

# 备用 1：小米 MiMo
XIAOMI_MIMO_API_KEY=your_xiaomi_api_key
XIAOMI_MIMO_API_URL=https://api.xiaomimimo.com/v1/chat/completions
XIAOMI_MIMO_MODEL=MiMo-7B-Chat-Instruct

# 备用 2：LongCat
LONGCAT_API_KEY=your_longcat_api_key
LONGCAT_API_URL=https://api.longcat.chat/v1/chat/completions
LONGCAT_MODEL=LongCat-Flash-Chat

# 备用 3：SenseNova（商汤）
SENSENOVA_API_KEY=your_sensenova_api_key
SENSENOVA_API_URL=https://token.sensenova.cn/v1/chat/completions
SENSENOVA_MODEL=deepseek-v4-flash

# 备用 4：GLM（通过 SenseNova）
GLM_API_KEY=your_glm_api_key
GLM_API_URL=https://token.sensenova.cn/v1/chat/completions
GLM_MODEL=glm-5.2

# 备用 5：Agnes
AGNES_API_KEY=your_agnes_api_key
AGNES_API_URL=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_MODEL=agnes-1.5-flash

# 备用 6：NVIDIA NIM
# NVIDIA_API_KEY=your_nvidia_api_key
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# 备用 7：阿里云百炼
BAILIAN_API_KEY=your_bailian_api_key
BAILIAN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
BAILIAN_MODEL=qwen-plus

# 备用 8：Dahl
DAHL_API_KEY=your_dahl_api_key
DAHL_API_URL=https://inference.dahl.global/v1/chat/completions
DAHL_MODEL=dahl-chat

# 备用 9：SiliconFlow
# SILICONFLOW_API_KEY=your_siliconflow_api_key
# SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/chat/completions
# SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# 备用 10：Ollama（本地）
# OLLAMA_API_KEY=ollama
# OLLAMA_API_URL=http://localhost:11434/api/chat
# OLLAMA_MODEL=qwen2.5:7b

# ── 搜索 API 配置 ────────────────────────
# Serper（Google 搜索代理）
SERPER_API_KEY=your_serper_api_key
# Bocha 博查万象（国内直连，语义重排序）
BOCHA_API_KEY=your_bocha_api_key
BOCHA_API_URL=https://api.bochaai.com/v1/web-search
# Tavily AI Search
TAVILY_API_KEY=your_tavily_api_key
TAVILY_API_URL=https://api.tavily.com/search
# Firecrawl 网页提取
FIRECRAWL_API_KEY=your_firecrawl_api_key
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1/scrape

# ── 其他 ────────────────────────────────
# GitHub Token（避免 API 限流）
GITHUB_TOKEN=your_github_token

# Admin API 鉴权密钥（留空则关闭鉴权）
ADMIN_API_KEY=